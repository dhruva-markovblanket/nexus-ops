generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String // "student", "teacher", "admin"
  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  studentProfile Student?
  teacherProfile Teacher?
  auditLogs      AuditLog[]
}

model Student {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentYear Int
  gpa            Float  @default(0.0)
  credits        Int    @default(0)

  enrollments Enrollment[]
  submissions Submission[]
}

model Teacher {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String
  subjects    String // comma-separated

  courses     Course[]
  headedDepts Department[] @relation("HeadOfDepartment")
}

model Department {
  id     String   @id @default(uuid())
  name   String   @unique
  headId String?  @unique
  head   Teacher? @relation("HeadOfDepartment", fields: [headId], references: [id])

  users   User[]   @relation("UserDepartment")
  courses Course[]
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  teacherId    String
  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  credits      Int
  semester     String

  enrollments Enrollment[]
  timetables  Timetable[]
  exams       Exam[]
  assignments Assignment[]
}

model Enrollment {
  id         String  @id @default(uuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade      String?
  attendance Float   @default(0.0)
  status     String  @default("active") // active, completed, dropped

  @@unique([studentId, courseId])
}

model Timetable {
  id        String @id @default(uuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek String
  startTime String
  endTime   String
  room      String
}

model Exam {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date     DateTime
  duration Int // in minutes
  room     String
  type     String // Midterm, Final, Quiz
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime
  maxMarks    Int

  submissions Submission[]
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())
  marks        Int?
  feedback     String?

  @@unique([assignmentId, studentId])
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String
  authorId   String
  targetRole String // "all", "student", "teacher", "admin"
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  timestamp DateTime @default(now())
  metadata  String? // JSON string
}
